# Copy to .env.local for local dev. On Vercel, set it under
# Project → Settings → Environment Variables instead.

# Base URL of the backend (osave-inv-helper-server), no trailing slash needed.
# Local: http://localhost:4000. Production: the Railway service's public URL,
# e.g. https://osave-inv-helper-server-production.up.railway.app
# It's built into the app at build time, so after changing it on Vercel,
# redeploy for it to take effect.
NEXT_PUBLIC_API_URL=http://localhost:4000
